# Admin App Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Security (server-only) ───────────────────────────────
# 32-byte hex strings (64 characters each)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=your-64-char-hex-encryption-secret
HMAC_SECRET=your-64-char-hex-hmac-secret

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Krave Microgreens <hello@kravemicrogreens.in>

# ─── Analytics (PostHog) ──────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── CAPTCHA (Cloudflare Turnstile) ───────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ─── App URL ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://admin.kravemicrogreens.in

# ─── Environment ──────────────────────────────────────────
NODE_ENV=development
