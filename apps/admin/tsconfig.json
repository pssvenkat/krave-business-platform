{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@krave/config/typescript/nextjs",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@krave/ui/components/*": ["../../packages/ui/src/components/*"],
      "@krave/ui/lib/*": ["../../packages/ui/src/lib/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
