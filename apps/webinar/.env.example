# Webinar App Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Security (server-only, never expose to browser) ──────
# 32-byte hex strings (64 characters each)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=your_64_char_hex_encryption_secret_hereyour-64-char-hex-encryption-secret
HMAC_SECRET=your_64_char_hex_hmac_secret_hereyour-64-char-hex-hmac-secret

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Krave Microgreens <hello@kravemicrogreens.in>

# ─── Analytics (PostHog) ──────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── CAPTCHA (Cloudflare Turnstile) ───────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ─── App URL ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://webinar.kravemicrogreens.in

# ─── Environment ──────────────────────────────────────────
NODE_ENV=development
