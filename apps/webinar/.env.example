# Webinar App Environment Variables
# Copy this file to .env.local and fill in your real values

# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Security (server-only, never expose to browser) ──────
# 32-byte hex strings (64 characters each)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=your_64_char_hex_encryption_secret_hereyour_64_char_hex_encryption_secret_here
HMAC_SECRET=your_64_char_hex_hmac_secret_hereyour_64_char_hex_hmac_secret_here

# ─── Supabase Service Role (server-only!) ──────────────────
# Used in API routes to bypass RLS for admin writes
# Found in Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=grow@kravemicrogreens.in

# ─── Analytics (PostHog) ──────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── CAPTCHA (Cloudflare Turnstile) ───────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ─── App URL ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://webinar.kravemicrogreens.in

# ─── Active Webinar ────────────────────────────────────────
# Set this to the UUID of the active webinar row in your Supabase `webinars` table
NEXT_PUBLIC_ACTIVE_WEBINAR_ID=

# ─── Environment ──────────────────────────────────────────
NODE_ENV=development
